# Copy to .env (gitignored) for local runs: `cp .env.example .env`. Everything is optional.
# On Fly, scripts/deploy.sh stages the non-empty values from .env as Fly secrets.

# The public HTTPS URL of this server. OAuth callbacks are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# Signs session cookies. Set it in production so sign-ins survive a restart: `openssl rand -hex 32`
SESSION_SECRET=

# Turns on /admin (attendees, block/delete, messages, events). Long and random: `openssl rand -hex 24`
ADMIN_TOKEN=

# Sign-in buttons appear on /register only for providers whose values are set (docs/OAUTH_SETUP.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# One line, with literal \n for the newlines of the .p8 key
APPLE_PRIVATE_KEY=

# Optional: raises the GitHub API rate limit for the profile cards (pushes this week, recent repos).
GITHUB_TOKEN=

# Other origins allowed to call the API (a second frontend host, e.g. the Base44 mirror). Comma-separated.
FRONTEND_ORIGINS=

# Tuning (defaults shown): when the Scout's clues stop, and the Scout's mutual-fit gate.
# SCOUT_END_AT=18:00
# SCOUT_FIT_MIN=0.5
# Local testing: NO_PROFILE=1 skips GitHub lookups, NO_SCOUT=1 turns the Scout off, OAUTH_FAKE=1 adds a fake sign-in.
